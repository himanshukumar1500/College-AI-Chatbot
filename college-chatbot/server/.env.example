# ---- Required ----
# MongoDB connection string (Atlas or local)
MONGO_URI=
# OpenAI API key (create one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000

# ---- Optional ----
# OpenAI model used for answers
OPENAI_MODEL=gpt-4o-mini
# Name of your college, used in the AI system prompt
COLLEGE_NAME=Sample Institute of Technology
# Allowed frontend origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173
# How long a login token stays valid
JWT_EXPIRES_IN=7d
# If both are set, an admin account is created on startup (if it does not exist yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=
